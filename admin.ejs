<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Админ-панель</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="card wide">
    <h1>Панель администратора</h1>
    <p>Управление пользователями системы</p>
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Имя пользователя</th>
          <th>Роль</th>
          <th>Действия</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(function(u) { %>
          <tr>
            <td><%= u.id %></td>
            <td><%= u.username %></td>
            <td>
              <span class="role-badge <%= u.role === 'admin' ? 'role-admin' : 'role-user' %>">
                <%= u.role %>
              </span>
            </td>
            <td>
              <% if (u.id === user.id) { %>
                <button class="btn-delete disabled" disabled title="Нельзя удалить самого себя">Удалить</button>
              <% } else { %>
                <form action="/admin/delete/<%= u.id %>" method="POST" style="margin: 0;">
                  <button type="submit" class="btn-delete" onclick="return confirm('Вы уверены, что хотите удалить этого пользователя?')">Удалить</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <div class="btn-group" style="flex-direction: row; margin-top: 20px;">
      <a href="/" class="btn btn-outline">На главную</a>
    </div>
  </div>
</body>
</html>